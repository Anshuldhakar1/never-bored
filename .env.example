# Copy to .env.local and fill in what you need. Never commit real keys.

# Claude, for coverage, sketches, line art and board import.
ANTHROPIC_API_KEY=

# Optional: image renders ("Render image").
GEMINI_API_KEY=
# RASTER_MODEL=gemini-2.5-flash-image

# Optional: a fully local, OpenAI-compatible model instead of Anthropic.
# Nothing leaves the machine; board import and image renders are switched off.
# LOCAL_MODEL_URL=http://localhost:11434/v1/chat/completions
# LOCAL_MODEL_NAME=llama3.1

# Free AI model (opt-in per user under Settings → AI provider). Defaults to
# Pollinations.ai's no-key endpoint (gpt-oss-20b): one request every ~30 s per IP,
# so requests queue on the server. Off automatically in local-model mode.
# FREE_MODEL=off                        # hide the option entirely
# FREE_MODEL_KEY=                       # a Pollinations key (or other provider's) — removes the 30 s spacing
# FREE_MODEL_URL=https://text.pollinations.ai/openai   # any OpenAI-compatible endpoint
# FREE_MODEL_NAME=openai
# FREE_MODEL_REASONING=low              # reasoning_effort sent to the model; "off" to omit it
# FREE_MODEL_GAP_MS=31000               # spacing between requests

# Optional: require a code before anyone can generate or share boards.
# BETA_ACCESS_CODE=

# Shared boards in Upstash Redis — for Vercel and other hosts without a writable disk.
# Vercel's Upstash Marketplace integration sets these for you.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN work too.)

# Deploying without a Vercel account:  npm run deploy -- --hook
# The project's deploy hook URL (ask the owner, privately). Anyone with it can deploy.
# DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...

# Where shared boards are stored locally (default ./.data). SHARING=off turns sharing off.
# DATA_DIR=.data
# SHARING=off
